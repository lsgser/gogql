/*
|--------------------------------------------------------------------------
| Schema registry
|--------------------------------------------------------------------------
|
| Composes all gogql Module values into one application (like schema/index.ts).
| All() returns module order: common first, then domains. LoaderFactories
| merges DataLoader maps from modules that export LoaderFactories().
|
| Regenerated by "gogql module add <name>"; safe to edit imports temporarily
| but prefer the CLI so new domains stay in sync.
|
*/

package schema

import (
	"github.com/lsgser/gogql"
	"{{.ModulePath}}/src/modules/common"
	"{{.ModulePath}}/src/modules/user"
)

// All returns every module composed into the GraphQL schema.
func All() []*gogql.Module {
	return []*gogql.Module{
		common.Module(),
		user.Module(),
	}
}

// LoaderFactories merges DataLoader factories from domain modules.
func LoaderFactories() gogql.LoaderFactories {
	return gogql.LoaderFactories{}
}
